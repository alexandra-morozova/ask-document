# Copy to backend/.env and fill in real values. Do not commit .env.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session-mode pooler (port 5432). Do not use the transaction pooler (:6543).
# Alembic needs session/direct behavior, not transaction pooling.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
ALLOWED_ORIGINS=http://localhost:5173

# Optional. Set when Driftwood confirms their email domain, e.g. driftwood.com
# ALLOWED_EMAIL_DOMAIN=
