# Copy to frontend/.env and fill in real values. Do not commit .env.
# Browser-safe values only — never the service-role key or DATABASE_URL.

VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional. Set when Driftwood confirms their email domain, e.g. driftwood.com
# VITE_ALLOWED_EMAIL_DOMAIN=
